{
  "manifest_version": 3,
  "name": "Send to Job Hunt",
  "version": "1.0.0",
  "description": "Sends the job posting you're looking at to Job Hunt, which scores it and tailors your CV.",
  "action": { "default_title": "Send to Job Hunt", "default_popup": "popup.html", "default_icon": { "48": "icon-48.png", "128": "icon-128.png" } },
  "icons": { "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["activeTab", "scripting", "clipboardWrite"]
}
